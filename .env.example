# HTTP listener
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
HTTP_IO_THREADS=4
HTTP_MAX_CONNECTIONS=10000
HTTP_MAX_HEADER_BYTES=16384
HTTP_MAX_BODY_BYTES=8192
HTTP_READ_TIMEOUT_MS=15000
HTTP_WRITE_TIMEOUT_MS=15000

# PostgreSQL (durable source of truth)
PG_DSN=postgresql://urlshortener:urlshortener_dev@127.0.0.1:5433/urlshortener
PG_POOL_SIZE=16
PG_ACQUIRE_TIMEOUT_MS=250
PG_CONNECT_TIMEOUT_SECONDS=3
PG_STATEMENT_TIMEOUT_MS=2000

# Redis (cache and distributed rate limiter)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=
REDIS_POOL_SIZE=16
REDIS_CONNECT_TIMEOUT_MS=200
REDIS_SOCKET_TIMEOUT_MS=200
REDIS_POOL_WAIT_TIMEOUT_MS=100
REDIS_CIRCUIT_FAILURE_THRESHOLD=5
REDIS_CIRCUIT_COOLDOWN_MS=2000

# Cache policy
CACHE_TTL_SECONDS=300
CACHE_NEGATIVE_TTL_SECONDS=10
CACHE_TOMBSTONE_TTL_SECONDS=300
CACHE_TTL_JITTER_PERCENT=10

# Distributed fixed-window limits (per client identity).
# The window is derived as BURST / RPS seconds; the burst value is the
# number of requests allowed in that window.
REDIRECT_RATE_LIMIT_RPS=2000
REDIRECT_RATE_LIMIT_BURST=4000
CREATE_RATE_LIMIT_RPS=20
CREATE_RATE_LIMIT_BURST=40
ADMIN_RATE_LIMIT_RPS=100
ADMIN_RATE_LIMIT_BURST=200
RATE_LIMIT_FAIL_OPEN_REDIRECT=true

# Request handling
WORKER_THREADS=16
WORKER_QUEUE_CAPACITY=4096
SHUTDOWN_GRACE_MS=5000
READINESS_REFRESH_MS=1000

# URL generation and public URL
PUBLIC_BASE_URL=http://localhost:8080
SHORT_CODE_LENGTH=7
SHORT_CODE_MAX_RETRIES=5

# Client identity (only trust proxy headers from these networks)
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Logging
LOG_LEVEL=info
LOG_ACCESS=false
